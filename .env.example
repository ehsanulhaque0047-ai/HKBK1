# ===================================================================
# HKBK College Student Management System (SIMP) - Environment Config
# ===================================================================
# Safe demonstration template. Do NOT put production secrets here.
# Copy this file to .env.local for local overrides.

# Application Information
VITE_APP_TITLE="HKBK College Student Information & Management Portal"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# Institutional Information
VITE_INSTITUTION_NAME="HKBK College of Engineering"
VITE_COLLEGE_CODE="1HK"
VITE_ACADEMIC_YEAR="2024-2025"
VITE_AFFILIATION="Visvesvaraya Technological University (VTU) Belagavi"

# Future Spring Boot API & PostgreSQL Backend Integration URL
# Defaults to mock LocalStorage provider when backend is offline
VITE_API_BASE_URL="http://localhost:8080/api/v1"

# Feature Flags
VITE_ENABLE_3D_VISUALS="true"
VITE_ENABLE_WEBGL_CAMPUS="true"
VITE_DEFAULT_PACKAGE_TIER="complete"
